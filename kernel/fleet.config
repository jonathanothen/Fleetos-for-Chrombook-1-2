# Config fragment on top of multi_v7_defconfig for Exynos 5250 (snow) and 5420 (peach-pit).
# Everything needed to reach the root filesystem is built in (=y) -> no initramfs.
CONFIG_LOCALVERSION="-fleet"
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_INFO_BTF is not set
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# Storage / filesystems (GPT is required for root=PARTUUID=)
CONFIG_PARTITION_ADVANCED=y
CONFIG_EFI_PARTITION=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_DW=y
CONFIG_MMC_DW_EXYNOS=y
CONFIG_MMC_DW_PLTFM=y
CONFIG_BLK_DEV_SD=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y

# USB (boot from stick)
CONFIG_USB=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_EXYNOS=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_OHCI_EXYNOS=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_EXYNOS=y
CONFIG_USB_DWC3_HOST=y
CONFIG_USB_STORAGE=y
CONFIG_PHY_EXYNOS5_USBDRD=y
CONFIG_PHY_SAMSUNG_USB2=y
CONFIG_PHY_EXYNOS_DP_VIDEO=y

# Power, regulators, clocks, RTC (snow: MAX77686/TPS65090, pit: MAX77802)
CONFIG_MFD_MAX77686=y
CONFIG_REGULATOR_MAX77686=y
CONFIG_REGULATOR_MAX77802=y
CONFIG_COMMON_CLK_MAX77686=y
CONFIG_RTC_DRV_MAX77686=y
CONFIG_MFD_TPS65090=y
CONFIG_REGULATOR_TPS65090=y
CONFIG_CHARGER_TPS65090=y
CONFIG_BATTERY_SBS=y
CONFIG_CHARGER_GPIO=y
CONFIG_I2C_S3C2410=y
CONFIG_SPI_S3C64XX=y

# Embedded controller (keyboard, battery tunnel)
CONFIG_CHROME_PLATFORMS=y
CONFIG_MFD_CROS_EC_DEV=y
CONFIG_CROS_EC=y
CONFIG_CROS_EC_I2C=y
CONFIG_CROS_EC_SPI=y
CONFIG_CROS_EC_PROTO=y
CONFIG_CROS_EC_CHARDEV=y
CONFIG_KEYBOARD_CROS_EC=y
CONFIG_I2C_CROS_EC_TUNNEL=y
CONFIG_INPUT_EVDEV=y

# Touchpad
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_ATMEL_MXT=y
CONFIG_INPUT_MOUSE=y
CONFIG_MOUSE_ELAN_I2C=y
CONFIG_HID_MULTITOUCH=y
CONFIG_I2C_HID_OF=y

# Display (DP -> LVDS bridge), backlight, console
CONFIG_DRM=y
CONFIG_DRM_EXYNOS=y
CONFIG_DRM_EXYNOS_DP=y
CONFIG_DRM_EXYNOS_MIXER=y
CONFIG_DRM_NXP_PTN3460=y
CONFIG_DRM_PARADE_PS8622=y
CONFIG_DRM_PANEL_SIMPLE=y
CONFIG_PWM=y
CONFIG_PWM_SAMSUNG=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_PWM=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_DRM_FBDEV_EMULATION=y

# Wifi + Bluetooth (Marvell 8797 over SDIO)
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_MARVELL=y
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_MWIFIEX=m
CONFIG_MWIFIEX_SDIO=m
CONFIG_BT=m
CONFIG_BT_MRVL=m
CONFIG_BT_MRVL_SDIO=m
CONFIG_RFKILL=y

# Audio
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_SAMSUNG=y
CONFIG_SND_SOC_SAMSUNG_I2S=y
CONFIG_SND_SOC_SNOW=y
CONFIG_SND_SOC_PEACH_PIT=y
CONFIG_SND_SOC_MAX98090=y
CONFIG_SND_SOC_MAX98095=y

# Memory: zram with zstd
CONFIG_ZRAM=y
CONFIG_ZSMALLOC=y
CONFIG_CRYPTO_ZSTD=y
CONFIG_CRYPTO_LZ4=y
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y

# systemd requirements
CONFIG_CGROUPS=y
CONFIG_AUTOFS_FS=y
CONFIG_FHANDLE=y
CONFIG_INOTIFY_USER=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
