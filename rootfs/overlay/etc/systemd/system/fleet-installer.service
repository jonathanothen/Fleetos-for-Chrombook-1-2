[Unit]
Description=FleetOS installer (runs only from the install stick)
ConditionKernelCommandLine=fleet_install=1
After=local-fs.target systemd-udev-settle.service getty@tty1.service
Conflicts=getty@tty1.service

[Service]
Type=simple
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
ExecStart=/usr/local/sbin/fleet-install

[Install]
WantedBy=multi-user.target
