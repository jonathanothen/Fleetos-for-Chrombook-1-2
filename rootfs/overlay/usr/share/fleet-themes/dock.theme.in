[PlankTheme]

[PlankDockTheme]
# FleetOS dock: @@LABEL@@. Flat, rounded; solid fill is used when there is no compositor.
HorizPadding=1.5
TopPadding=1.5
BottomPadding=1.5
ItemPadding=3
IndicatorSize=5
IconShadowSize=0
UrgentBounceHeight=1.2
LaunchBounceHeight=0.6
FadeOpacity=1
ClickTime=250
UrgentBounceTime=600
LaunchBounceTime=600
ActiveTime=250
SlideTime=300
FadeTime=250
HideTime=250
GlowSize=30
GlowTime=10000
GlowPulse=2000
UrgentGlowTime=10000
ItemMoveTime=450
CascadeHide=true
TopRoundness=18
BottomRoundness=18
LineWidth=1
OuterStrokeColor=@@DOCK_OUT@@
FillStartColor=@@DOCK_FILL@@
FillEndColor=@@DOCK_FILL@@
InnerStrokeColor=@@DOCK_IN@@
BadgeColor=255;;90;;82;;255
