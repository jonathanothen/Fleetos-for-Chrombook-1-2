/* FleetOS GTK3 theme: @@LABEL@@
 * Generated by fleet-theme-gen from /usr/share/fleet-themes/gtk.css.in + @@ID@@.conf. Do not edit the output.
 * Flat, soft, rounded. Sits on top of @@BASE@@ (installed at build time).
 */
@import url("file:///usr/share/themes/@@BASE@@/gtk-3.0/gtk.css");

@define-color fleet_window   @@BG@@;
@define-color fleet_surface  @@SURFACE@@;
@define-color fleet_bar      @@BAR@@;
@define-color fleet_side     @@SIDE@@;
@define-color fleet_line     @@LINE@@;
@define-color fleet_line2    @@LINE2@@;
@define-color fleet_text     @@TEXT@@;
@define-color fleet_muted    @@MUTED@@;
@define-color fleet_accent   @@ACCENT@@;
@define-color fleet_accent_h @@ACCENT_H@@;
@define-color fleet_accent_p @@ACCENT_P@@;
@define-color fleet_btn      @@BTN@@;
@define-color fleet_btn_h    @@BTN_H@@;
@define-color fleet_btn_a    @@BTN_A@@;
@define-color fleet_track    @@TRACK@@;
@define-color fleet_red      #FF5A52;
@define-color fleet_green    #34C759;

@define-color theme_selected_bg_color @fleet_accent;
@define-color theme_selected_fg_color #FFFFFF;
@define-color selected_bg_color       @fleet_accent;
@define-color selected_fg_color       #FFFFFF;
@define-color theme_bg_color          @fleet_window;
@define-color theme_base_color        @fleet_surface;
@define-color theme_fg_color          @fleet_text;
@define-color theme_text_color        @fleet_text;
@define-color borders                 @fleet_line;
@define-color link_color              @fleet_accent;

/* ---------- Base ---------- */
* { outline-color: alpha(@fleet_accent, 0.45); outline-style: solid; outline-width: 2px; outline-offset: -2px; -gtk-outline-radius: 10px; }
/* Only real windows get the window colour. A bare ".background" also matches inner containers, which then
   paint square corners over their rounded parents (the black "double corners"). */
window, window.background, dialog.background { background-color: @fleet_window; color: @fleet_text; }
window.csd, decoration { border-radius: 14px; }
decoration { box-shadow: 0 8px 28px alpha(black, @@SHADOW@@), 0 0 0 1px alpha(@@OVER@@, 0.08); }

selection, *:selected, .view:selected, textview text selection {
  background-color: @fleet_accent; color: #FFFFFF;
}

/* ---------- Buttons ---------- */
button {
  background-image: none; background-color: @fleet_btn; color: @fleet_text;
  border: 1px solid @fleet_line; border-radius: 10px;
  box-shadow: 0 1px 1px alpha(black, 0.05);
  padding: 4px 14px; min-height: 22px; text-shadow: none;
  transition: background-color 120ms ease, border-color 120ms ease;
}
button:hover   { background-color: @fleet_btn_h; border-color: @fleet_line2; }
button:active, button:checked { background-color: @fleet_btn_a; border-color: @fleet_line2; box-shadow: none; }
button:disabled { color: alpha(@fleet_text, 0.35); background-color: alpha(@fleet_btn, 0.6); }

button.suggested-action, button.default {
  background-color: @fleet_accent; color: #FFFFFF; border-color: @fleet_accent; box-shadow: none;
}
button.suggested-action:hover, button.default:hover   { background-color: @fleet_accent_h; border-color: @fleet_accent_h; }
button.suggested-action:active, button.default:active { background-color: @fleet_accent_p; border-color: @fleet_accent_p; }
button.destructive-action { background-color: @fleet_red; color: #FFFFFF; border-color: @fleet_red; box-shadow: none; }
button.flat, toolbar button, headerbar button.flat {
  background-color: transparent; border-color: transparent; box-shadow: none;
}
button.flat:hover, toolbar button:hover { background-color: alpha(@@OVER@@, 0.07); }
button.flat:active, toolbar button:active, toolbar button:checked { background-color: alpha(@@OVER@@, 0.12); }
button.circular { border-radius: 999px; padding: 4px; min-width: 24px; }

/* ---------- Text inputs ---------- */
entry, spinbutton, .view, textview {
  background-color: @fleet_surface; color: @fleet_text;
  border: 1px solid @fleet_line; border-radius: 10px; box-shadow: none; padding: 4px 8px; min-height: 22px;
}
textview, textview text, .view { border-radius: 0; border: none; }
/* The text area itself is the "text" node. Set both colours together so dark themes never end up with
   light text on a light background (editors such as Mousepad). */
textview text, .view text, textview.view, iconview, treeview.view {
  background-color: @fleet_surface; color: @fleet_text;
}
textview text selection, .view text selection { background-color: @fleet_accent; color: #FFFFFF; }
entry:focus, spinbutton:focus { border-color: @fleet_accent; box-shadow: 0 0 0 3px alpha(@fleet_accent, 0.25); outline-style: none; }
entry:disabled { background-color: alpha(@fleet_surface, 0.6); color: alpha(@fleet_text, 0.4); }
entry selection { background-color: @fleet_accent; }

/* ---------- Switches, check, radio, scales ---------- */
switch { background-color: @fleet_track; border: none; border-radius: 999px; min-width: 42px; min-height: 24px; box-shadow: none; }
switch:checked { background-color: @fleet_green; }
switch slider { background-color: #FFFFFF; border: none; border-radius: 999px; min-width: 20px; min-height: 20px; margin: 2px; box-shadow: 0 1px 3px alpha(black, 0.3); }
check, radio { background-image: none; background-color: @fleet_btn; border: 1px solid @fleet_line2; box-shadow: none; min-width: 16px; min-height: 16px; }
check { border-radius: 5px; }
radio { border-radius: 999px; }
check:checked, radio:checked, check:indeterminate, radio:indeterminate { background-color: @fleet_accent; border-color: @fleet_accent; color: #FFFFFF; }
scale trough { background-color: @fleet_track; border-radius: 999px; min-height: 4px; min-width: 4px; border: none; }
scale highlight { background-color: @fleet_accent; border-radius: 999px; border: none; }
scale slider { background-color: #FFFFFF; border: 1px solid @fleet_line2; border-radius: 999px; min-width: 18px; min-height: 18px; box-shadow: 0 1px 3px alpha(black, 0.25); }
progressbar trough { background-color: @fleet_track; border: none; border-radius: 999px; min-height: 6px; }
progressbar progress { background-color: @fleet_accent; border: none; border-radius: 999px; min-height: 6px; }
levelbar block.filled { background-color: @fleet_green; border-radius: 999px; }

/* ---------- Header bars / titlebars / toolbars ---------- */
headerbar, .titlebar {
  background-color: @fleet_bar; background-image: none; color: @fleet_text;
  border: none; border-bottom: 1px solid @fleet_line; box-shadow: none;
  border-radius: 14px 14px 0 0; min-height: 40px; padding: 0 8px;
}
headerbar:backdrop, .titlebar:backdrop { background-color: @fleet_window; color: @fleet_muted; }
toolbar, .toolbar, .inline-toolbar { background-color: @fleet_bar; border-color: @fleet_line; padding: 4px; }
statusbar { color: @fleet_muted; }
separator { background-color: @fleet_line; min-width: 1px; min-height: 1px; }

/* ---------- Menus & popovers ---------- */
/* A menu is two nested boxes: the popup WINDOW and the menu inside it. Style only the inner one (one box, no
   nesting) and make the window itself invisible. No box-shadow: the window is exactly as big as the menu, so a
   shadow would be clipped at the edges. Needs the compositor (see "fleet-effects"). */
window.popup, window.popup.background, window.popup.csd {
  background-color: transparent; background-image: none; border: none; box-shadow: none; padding: 0; border-radius: 0;
}
menu, .menu, popover.background {
  background-color: @@MENU@@; color: @fleet_text; border: 1px solid alpha(@@OVER@@, 0.14); border-radius: 12px;
  box-shadow: none; padding: 6px;
}
menuitem, modelbutton { border-radius: 7px; padding: 5px 10px; margin: 1px 0; color: @fleet_text; }
menuitem:hover, modelbutton:hover, menu menuitem:hover { background-color: @fleet_accent; color: #FFFFFF; }
menuitem:hover label, menuitem:hover image { color: #FFFFFF; }
menuitem separator, menu separator { margin: 5px 6px; }
tooltip, tooltip.background { background-color: #2C2C2E; color: #FFFFFF; border: none; border-radius: 8px; box-shadow: 0 4px 12px alpha(black, 0.25); }
tooltip label { color: #FFFFFF; padding: 2px 4px; }

/* ---------- Lists, trees, sidebars ---------- */
list, treeview.view, .sidebar { background-color: @fleet_surface; }
.sidebar, placessidebar, stacksidebar { background-color: @fleet_side; border-color: @fleet_line; }
row, list row { border-radius: 8px; margin: 1px 6px; padding: 3px 4px; }
row:hover, list row:hover { background-color: alpha(@@OVER@@, 0.06); }
row:selected, list row:selected, placessidebar row:selected, treeview.view:selected {
  background-color: @fleet_accent; color: #FFFFFF;
}
placessidebar row:selected label, placessidebar row:selected image { color: #FFFFFF; }
treeview.view { border-radius: 0; margin: 0; }
treeview.view header button { border-radius: 0; background-color: @fleet_bar; border-width: 0 1px 1px 0; box-shadow: none; }

/* ---------- Notebooks / tabs ---------- */
notebook > header { background-color: @fleet_side; border-color: @fleet_line; }
notebook > header > tabs > tab { border-radius: 8px; margin: 3px 2px; padding: 3px 12px; border: none; background-color: transparent; }
notebook > header > tabs > tab:hover   { background-color: alpha(@@OVER@@, 0.07); }
notebook > header > tabs > tab:checked { background-color: @fleet_surface; box-shadow: 0 1px 2px alpha(black, 0.15); }

/* ---------- Scrollbars (thin, rounded) ---------- */
scrollbar { background-color: transparent; border: none; }
scrollbar slider { background-color: alpha(@@OVER@@, 0.30); border-radius: 999px; min-width: 7px; min-height: 7px; border: 2px solid transparent; background-clip: padding-box; }
scrollbar slider:hover { background-color: alpha(@@OVER@@, 0.48); }
scrollbar.overlay-indicator:not(.hovering) slider { min-width: 5px; min-height: 5px; }

/* ---------- Dialogs / info bars ---------- */
messagedialog.background, dialog.background { border-radius: 14px; }
messagedialog .dialog-action-area button { border-radius: 10px; }
infobar { border-radius: 12px; border: none; background-color: alpha(@fleet_accent, 0.16); color: @fleet_text; }
infobar.error   { background-color: alpha(@fleet_red, 0.18); }
infobar.warning { background-color: alpha(#FF9F0A, 0.20); }
infobar.success { background-color: alpha(@fleet_green, 0.20); }
frame > border, .frame { border-radius: 10px; border-color: @fleet_line; }

/* ---------- Xfce panel ---------- */
.xfce4-panel, #XfcePanelWindow { background-color: @@PANEL@@; color: @fleet_text; border-bottom: 1px solid alpha(@@OVER@@, 0.07); }
.xfce4-panel button, .xfce4-panel .tasklist button {
  background-color: transparent; border: none; border-radius: 8px; box-shadow: none; padding: 1px 8px; min-height: 20px;
}
.xfce4-panel button:hover   { background-color: alpha(@@OVER@@, 0.08); }
.xfce4-panel button:checked, .xfce4-panel button:active { background-color: alpha(@fleet_accent, 0.22); color: @fleet_text; }
.xfce4-panel label { color: @fleet_text; font-weight: 500; }

/* ---------- Whisker menu ---------- */
#whiskermenu-window, .whiskermenu-window { border-radius: 16px; background-color: @@MENU@@; border: 1px solid alpha(@@OVER@@, 0.10); box-shadow: 0 14px 40px alpha(black, @@SHADOW@@); }
#whiskermenu-window entry { border-radius: 999px; padding: 5px 12px; }

/* ---------- Thunar tweaks ---------- */
.thunar .sidebar, window.thunar placessidebar { background-color: @fleet_side; }
.thunar toolbar { border-bottom: 1px solid @fleet_line; }
