#!/bin/bash
# Step the screen backlight by one level (the backlight has only 8 steps, 0-7; never go to 0).
# Usage: fleet-brightness up|down
case "$1" in
  up)   arg="+1" ;;
  down) arg="1-" ;;
  *) echo "usage: $0 up|down"; exit 2 ;;
esac
brightnessctl -q -n1 set "$arg" 2>/dev/null || sudo -n brightnessctl -q -n1 set "$arg"
