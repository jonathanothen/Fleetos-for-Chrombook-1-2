# Shared build configuration. Override with environment variables.
SUITE="${SUITE:-trixie}"
MIRROR="${MIRROR:-http://deb.debian.org/debian}"

# Linux LTS kernel from kernel.org. Bump to the newest 6.12.x / 6.18.x when needed.
KERNEL_VERSION="${KERNEL_VERSION:-6.12.40}"

# Which machines the USB stick must boot on: auto (both) | snow (XE303C12) | pit (XE503C12)
USB_MODEL="${USB_MODEL:-auto}"

# There is no built-in user account: the first-boot wizard creates the owner's account.

OUT_DIR="${OUT_DIR:-$PWD/out}"
WORK_DIR="${WORK_DIR:-$PWD/work}"
